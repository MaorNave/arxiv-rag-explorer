# Copy to .env and adjust. Every value below shows its default;
# real environment variables always take precedence over this file.

# --- Dataset & storage -------------------------------------------------------
# A .jsonl file, a directory containing one, or an http(s) URL.
DATA_PATH=data/arxiv_2.9k.jsonl
# Index, reranker model, uploads and generated images live here.
STORAGE_DIR=storage
WATCH_DATASET=true            # rebuild automatically when the file changes
WATCH_INTERVAL_S=10
MAX_UPLOAD_MB=512             # largest .jsonl accepted by the UI upload

# --- Web server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8080

# --- Local models (Ollama) -----------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
MANAGED_OLLAMA=true           # no Ollama running? the app downloads & runs its own copy in storage/runtime
OLLAMA_RUNTIME_VERSION=0.32.5 # version of that copy (0.32.5 = last one with image generation)
LLM_MODEL=qwen3.5:4b          # qwen3.5:2b for 4 GB RAM, qwen3.5:9b for higher quality
EMBED_MODEL=nomic-embed-text  # bge-m3 = multilingual (slower to index)
AUTO_PULL_MODELS=true         # download missing Ollama models on startup
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=1024
LLM_THINKING=false            # true = stream Qwen's reasoning (slower)
LLM_KEEP_ALIVE=30m
LLM_TIMEOUT_S=300             # seconds Ollama may stay silent (e.g. loading a model) before a request fails

# --- Retrieval -----------------------------------------------------------------
TOP_K=5                       # abstracts given to the LLM
FETCH_K=20                    # candidates per ranked list before fusion
QUERY_REWRITE=true            # LLM "understand query" step (rewrites + keywords)
ANALYSIS_TIMEOUT_S=45         # give up on the query plan after this (keyword fallback)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2   # "none" disables reranking
RERANK_CANDIDATES=20
RERANK_MAX_TOKENS=384
RERANK_WEIGHT=2.0
# RRF weights; "auto" = 1.0/1.0 with the reranker, 0.25/1.5 without it.
REWRITE_WEIGHT=auto
KEYWORD_WEIGHT=auto
CHUNK_SIZE=2000               # characters; abstracts longer than this are split
CHUNK_OVERLAP=200
EMBED_BATCH_SIZE=64
# Embedding task prefixes (EMBED_DOC_PREFIX, EMBED_QUERY_PREFIX) are picked per model automatically
# (nomic-embed-text: "search_document: " / "search_query: "). Set them only for other models, quoted
# so trailing spaces are kept, e.g. EMBED_QUERY_PREFIX="query: ". An empty value means no prefix.

# --- Bonus: image generation (free options only) -------------------------------
# auto = local Ollama model if installed and supported by your Ollama version, then
#        Cloudflare Workers AI (if configured), then Pollinations (works without sign-up).
IMAGE_PROVIDER=auto           # auto | ollama | cloudflare | pollinations | none
IMAGE_TIMEOUT_S=120           # per external API call
LOCAL_IMAGE_TIMEOUT_S=600     # local generation can take minutes on a laptop
# Local, free (macOS): set up automatically by the app (Ollama 0.32.5 image server in storage/runtime)
LOCAL_IMAGES=auto             # auto (Macs with >= 16 GB RAM) | on | off
LOCAL_IMAGE_PORT=11435
OLLAMA_IMAGE_MODEL=x/flux2-klein:4b
# Empty = auto: the app's image server, then the main Ollama (once it supports images again)
OLLAMA_IMAGE_BASE_URL=
# Cloudflare Workers AI, free plan: 10,000 neurons/day (about 170 FLUX.1 schnell images)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Pollinations, free: no key needed; a free account key (enter.pollinations.ai) removes the watermark
POLLINATIONS_TOKEN=
POLLINATIONS_MODEL=flux

LOG_LEVEL=INFO
